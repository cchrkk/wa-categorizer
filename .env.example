# ---------------------------------------------------------------
# Copia questo file in .env e riempi i valori.
#
# SE USI DOCKER: qui vanno SOLO i segreti (chiavi, token). Le impostazioni
# non segrete (LOG_LEVEL, TRANSCRIBE_*, WEB_*) stanno in `environment:` nel
# compose, così le vedi e le modifichi dal pannello di Dockhand. Motivo: il
# pannello non mostra le variabili che arrivano da `env_file:`.
# ---------------------------------------------------------------

# --- Log ---
LOG_LEVEL=info
LOG_PRETTY=true

# --- Dove salvare la sessione WhatsApp (QR) ---
AUTH_DIR=auth
# --- Dove salvare dati, log, media e rubrica ---
DATA_DIR=data

# ---------------------------------------------------------------
# TRASCRIZIONE VOCALI
# backend: none | openai | command
#   none    -> non trascrive (i vocali restano non gestiti)  [default]
#   openai  -> API OpenAI / whisper-compatibili (Groq, ecc.)
#   command -> lancia un comando locale (whisper.cpp, faster-whisper, ...)
#
# NB: se scegli "command" o "openai" riempi anche le variabili del blocco sotto,
#     altrimenti `npm run check` segnala errore.
TRANSCRIBE_BACKEND=none

# --- backend "command" ---
# {input} = percorso del file audio scaricato (ogg/opus)
# Il comando deve stampare SOLO la trascrizione su stdout.
# Esempi:
#   whisper.cpp:    WHISPER_DIR\main.exe -m WHISPER_DIR\models\ggml-small.bin -f {input} -nt --language it
#   faster-whisper: python -m faster_whisper.cli {input} --model small --language it
TRANSCRIBE_COMMAND=
# Se il comando ha bisogno di convertire prima in wav 16k mono
TRANSCRIBE_FFMPEG=ffmpeg
TRANSCRIBE_LANGUAGE=it

# --- backend "openai" (vale anche per Groq e altri endpoint OpenAI-compatibili) ---
# Groq:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_TRANSCRIBE_MODEL=whisper-large-v3-turbo   (oppure whisper-large-v3)
#   OPENAI_CLASSIFY_MODEL=openai/gpt-oss-120b        (oppure openai/gpt-oss-20b)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=whisper-1
# opzionale: modello per la classificazione LLM delle regole
OPENAI_CLASSIFY_MODEL=gpt-4o-mini

# ---------------------------------------------------------------
# PANNELLO WEB (facoltativo)
# Editor delle regole + prova di una regola con un testo o un vocale.
# Il test passa sempre in dry-run: non può inviare nulla su WhatsApp.
# ---------------------------------------------------------------

# Avvia il pannello. false = spento (default)
WEB_ENABLED=false

# Porta di ascolto
WEB_PORT=8099

# Dove ascoltare:
#   127.0.0.1  solo questa macchina (default, sicuro)
#   0.0.0.0    visibile sulla LAN
# ATTENZIONE: con 0.0.0.0 chiunque raggiunga la porta può rileggere e
# RISCRIVERE le tue regole. Metti sempre un WEB_TOKEN.
WEB_BIND=127.0.0.1

# Token di accesso. Se lo lasci vuoto ne viene generato uno al primo avvio,
# salvato in data/web-token.txt e stampato nei log.
WEB_TOKEN=

# ---------------------------------------------------------------
# AZIONI
# ---------------------------------------------------------------

# Telegram (notifiche)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# solo per il messaggio di aiuto di `npm run check`
TELEGRAM_BOT_USERNAME=

# Home Assistant
# Il token si crea in HA: Profilo -> Sicurezza -> Token di accesso a lunga durata
# `npm run check` verifica URL e token e ti dice nome della casa e versione.
#
# ATTENZIONE: HA_URL va compilato. Se lo lasci vuoto o con un indirizzo
# sbagliato, le azioni ha.* falliscono con "fetch failed" a ogni messaggio.
# Esempi: http://192.168.1.50:8123  oppure  http://homeassistant.local:8123
HA_URL=
HA_TOKEN=
# webhook id per l'azione "ha.webhook"
HA_WEBHOOK_ID=

# Timeout per le azioni di rete (ms)
ACTION_TIMEOUT_MS=15000
